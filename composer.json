{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "aliyuncs/oss-sdk-php": "^2.7",
        "brick/money": "^0.14.2",
        "doctrine/doctrine-bundle": "^3.3.2",
        "doctrine/orm": "^3.7",
        "godruoyi/php-snowflake": "^3.2",
        "knplabs/knp-paginator-bundle": "^6.10",
        "nelmio/cors-bundle": "^2.6",
        "obs/esdk-obs-php": "^3.24",
        "siganushka/admin-bundle": "dev-main",
        "siganushka/alipay-api": "^1.3",
        "siganushka/api-factory": "^1.3",
        "siganushka/api-factory-bundle": "^1.3",
        "siganushka/doctrine-contracts": "^1.2",
        "siganushka/generic-bundle": "^1.3",
        "siganushka/github-api": "^1.3",
        "siganushka/media-bundle": "^1.3",
        "siganushka/order-bundle": "^1.3",
        "siganushka/payment-bundle": "dev-main",
        "siganushka/product-bundle": "^1.3",
        "siganushka/region-bundle": "^1.3",
        "siganushka/request-token-bundle": "^1.3",
        "siganushka/user-bundle": "^1.3",
        "siganushka/wechat-api": "^1.3",
        "siganushka/wxpay-api": "^1.3",
        "spatie/image-optimizer": "^1.10",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dom-crawler": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/redis-messenger": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^3.4",
        "symfony/stopwatch": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-autocomplete": "^3.4",
        "symfony/validator": "8.1.*",
        "symfony/workflow": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^3.24",
        "twig/intl-extra": "^3.26"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "predis/predis": "^3.6",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "tools:run": [
            "tools/vendor/bin/php-cs-fixer fix",
            "tools/vendor/bin/twigcs",
            "tools/vendor/bin/simple-phpunit",
            "tools/vendor/bin/phpstan"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../doctrine-contracts",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../generic-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../region-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../media-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../product-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../order-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../user-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../admin-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../payment-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../request-token-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../api-factory",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../api-factory-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../github-api",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../alipay-api",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../wxpay-api",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../wechat-api",
            "options": {
                "symlink": true
            }
        }
    ]
}
