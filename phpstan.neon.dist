parameters:
    level: 9
    paths:
        - src
        - tests
        - translations
    bootstrapFiles:
        - tools/vendor/bin/.phpunit/phpunit/vendor/autoload.php
    ignoreErrors:
        - '#is never assigned int so it can be removed from the property type#'
        - '#no value type specified in iterable type array#'
        - '#does not specify its types: TData#'
    excludePaths:
        - src/Kernel.php
